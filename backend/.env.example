FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
TARGET_INDUSTRIES=SaaS,Software,IT Services
TARGET_REVENUE_MIN=1000000
TARGET_REVENUE_MAX=50000000
